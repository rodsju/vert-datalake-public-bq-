config {
  type: "table",
  schema: "gold",
  name: "dashboard_summary",
  assertions: {
    uniqueKey: ["metric_name"],
    nonNull: ["metric_name"]
  },
  tags: ["gold", "gold_dashboard_summary"]
}

SELECT
  metric_name,
  CAST(metric_value AS NUMERIC) AS metric_value,
  CAST(NULL AS STRING) AS metric_text,
  CAST(NULL AS NUMERIC) AS previous_value,
  CAST(NULL AS NUMERIC) AS variation_percent,
  CURRENT_TIMESTAMP() AS computed_at

FROM UNNEST([

  STRUCT(
    'fidc_total_funds' AS metric_name,
    (
      SELECT total_funds
      FROM ${ref("fidc_evolution")}
      ORDER BY reference_date DESC
      LIMIT 1
    ) AS metric_value
  ),

  STRUCT(
    'fidc_total_pl' AS metric_name,
    (
      SELECT total_pl
      FROM ${ref("fidc_evolution")}
      ORDER BY reference_date DESC
      LIMIT 1
    ) AS metric_value
  ),

  STRUCT(
    'debenture_total_offers' AS metric_name,
    (
      SELECT SUM(offer_count)
      FROM ${ref("debenture_evolution")}
    ) AS metric_value
  ),

  STRUCT(
    'debenture_total_volume' AS metric_name,
    (
      SELECT SUM(total_volume)
      FROM ${ref("debenture_evolution")}
    ) AS metric_value
  ),

  STRUCT(
    'cra_total' AS metric_name,
    (
      SELECT total_cras
      FROM ${ref("cra_evolution")}
      WHERE NOT COALESCE(is_provisional, FALSE)
      ORDER BY reference_date DESC
      LIMIT 1
    ) AS metric_value
  ),

  STRUCT(
    'cra_total_saldo' AS metric_name,
    (
      SELECT total_saldo
      FROM ${ref("cra_evolution")}
      WHERE NOT COALESCE(is_provisional, FALSE)
      ORDER BY reference_date DESC
      LIMIT 1
    ) AS metric_value
  ),

  STRUCT(
    'cri_total' AS metric_name,
    (
      SELECT total_cris
      FROM ${ref("cri_evolution")}
      WHERE NOT COALESCE(is_provisional, FALSE)
      ORDER BY reference_date DESC
      LIMIT 1
    ) AS metric_value
  ),

  STRUCT(
    'cri_total_saldo' AS metric_name,
    (
      SELECT total_saldo
      FROM ${ref("cri_evolution")}
      WHERE NOT COALESCE(is_provisional, FALSE)
      ORDER BY reference_date DESC
      LIMIT 1
    ) AS metric_value
  ),

  STRUCT(
    'sre_total_offerings' AS metric_name,
    (
      SELECT total_offerings
      FROM ${ref("offering_stats")}
      LIMIT 1
    ) AS metric_value
  ),

  STRUCT(
    'sre_total_volume' AS metric_name,
    (
      SELECT total_volume
      FROM ${ref("offering_stats")}
      LIMIT 1
    ) AS metric_value
  )

])