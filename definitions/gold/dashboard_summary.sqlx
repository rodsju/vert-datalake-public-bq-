config {
  type: "table",
  schema: "gold",
  name: "dashboard_summary",
  assertions: {
    uniqueKey: ["metric_name"],
    nonNull: ["metric_name"]
  },
  tags: ["gold", "gold_dashboard_summary"]
}

WITH fidc_ranked AS (
  SELECT
    reference_date,
    total_funds,
    total_pl,
    ROW_NUMBER() OVER (ORDER BY reference_date DESC) AS rn
  FROM ${ref("fidc_evolution")}
  WHERE NOT COALESCE(is_provisional, FALSE)
),

cra_ranked AS (
  SELECT
    reference_date,
    total_cras,
    total_saldo,
    ROW_NUMBER() OVER (ORDER BY reference_date DESC) AS rn
  FROM ${ref("cra_evolution")}
  WHERE NOT COALESCE(is_provisional, FALSE)
),

cri_ranked AS (
  SELECT
    reference_date,
    total_cris,
    total_saldo,
    ROW_NUMBER() OVER (ORDER BY reference_date DESC) AS rn
  FROM ${ref("cri_evolution")}
  WHERE NOT COALESCE(is_provisional, FALSE)
),

debenture_ranked AS (
  SELECT
    year,
    offer_count,
    total_volume,
    ROW_NUMBER() OVER (ORDER BY year DESC) AS rn
  FROM ${ref("debenture_evolution")}
),

metrics AS (

  SELECT
    'fidc_total_funds' AS metric_name,
    CAST(MAX(IF(rn = 1, total_funds, NULL)) AS NUMERIC) AS metric_value,
    CAST(MAX(IF(rn = 2, total_funds, NULL)) AS NUMERIC) AS previous_value
  FROM fidc_ranked

  UNION ALL

  SELECT
    'fidc_total_pl' AS metric_name,
    CAST(MAX(IF(rn = 1, total_pl, NULL)) AS NUMERIC) AS metric_value,
    CAST(MAX(IF(rn = 2, total_pl, NULL)) AS NUMERIC) AS previous_value
  FROM fidc_ranked

  UNION ALL

  SELECT
    'cra_total' AS metric_name,
    CAST(MAX(IF(rn = 1, total_cras, NULL)) AS NUMERIC) AS metric_value,
    CAST(MAX(IF(rn = 2, total_cras, NULL)) AS NUMERIC) AS previous_value
  FROM cra_ranked

  UNION ALL

  SELECT
    'cra_total_saldo' AS metric_name,
    CAST(MAX(IF(rn = 1, total_saldo, NULL)) AS NUMERIC) AS metric_value,
    CAST(MAX(IF(rn = 2, total_saldo, NULL)) AS NUMERIC) AS previous_value
  FROM cra_ranked

  UNION ALL

  SELECT
    'cri_total' AS metric_name,
    CAST(MAX(IF(rn = 1, total_cris, NULL)) AS NUMERIC) AS metric_value,
    CAST(MAX(IF(rn = 2, total_cris, NULL)) AS NUMERIC) AS previous_value
  FROM cri_ranked

  UNION ALL

  SELECT
    'cri_total_saldo' AS metric_name,
    CAST(MAX(IF(rn = 1, total_saldo, NULL)) AS NUMERIC) AS metric_value,
    CAST(MAX(IF(rn = 2, total_saldo, NULL)) AS NUMERIC) AS previous_value
  FROM cri_ranked

  UNION ALL

  SELECT
    'debenture_total_offers' AS metric_name,
    CAST(MAX(IF(rn = 1, offer_count, NULL)) AS NUMERIC) AS metric_value,
    CAST(MAX(IF(rn = 2, offer_count, NULL)) AS NUMERIC) AS previous_value
  FROM debenture_ranked

  UNION ALL

  SELECT
    'debenture_total_volume' AS metric_name,
    CAST(MAX(IF(rn = 1, total_volume, NULL)) AS NUMERIC) AS metric_value,
    CAST(MAX(IF(rn = 2, total_volume, NULL)) AS NUMERIC) AS previous_value
  FROM debenture_ranked

  UNION ALL

  SELECT
    'sre_total_offerings' AS metric_name,
    CAST(total_offerings AS NUMERIC) AS metric_value,
    CAST(NULL AS NUMERIC) AS previous_value
  FROM ${ref("offering_stats")}

  UNION ALL

  SELECT
    'sre_total_volume' AS metric_name,
    CAST(total_volume AS NUMERIC) AS metric_value,
    CAST(NULL AS NUMERIC) AS previous_value
  FROM ${ref("offering_stats")}
)

SELECT
  metric_name,
  metric_value,
  CAST(NULL AS STRING) AS metric_text,
  previous_value,

  SAFE_MULTIPLY(
    SAFE_DIVIDE(metric_value - previous_value, previous_value),
    100
  ) AS variation_percent,

  CURRENT_TIMESTAMP() AS computed_at

FROM metrics