config {
  type: "table",
  schema: "gold",
  name: "fidc_evolution",

  assertions: {
    uniqueKey: ["reference_date"],
    nonNull: ["reference_date"]
  },
  dependencies: ["fidc_reports_fundos"],
  tags: ["gold", "gold_fidc_evolution"]
}

SELECT
  reference_date,

  COUNT(DISTINCT cnpj_fundo) AS total_funds,
  SUM(patrimonio_liquido) AS total_pl,
  AVG(patrimonio_liquido) AS avg_pl,
  FALSE as is_provisional,

  CURRENT_TIMESTAMP() AS computed_at

FROM ${ref("fidc_reports_fundos")}

WHERE patrimonio_liquido > 0
  AND reference_date IS NOT NULL
  AND cnpj_fundo IS NOT NULL

GROUP BY
  reference_date