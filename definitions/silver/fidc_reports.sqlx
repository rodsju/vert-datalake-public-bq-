-- definitions/silver/fidc_reports.sqlx

config {
  type: "view",
  schema: "silver",
  name: "fidc_reports",
  dependencies: ["bronze.cvm_fidc_reports"],
  tags: ["silver", "silver_fidc_reports"]
}

SELECT
CAST(COALESCE(cnpj_fundo, cnpj_fundo_classe) AS STRING) AS cnpj_fundo,
  *
FROM ${ref("cvm_fidc_reports")}
WHERE  reference_date IS NOT NULL